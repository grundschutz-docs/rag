QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=grundschutzpp

# "ollama" (local, free) or "openai" (paid) -- same Qdrant collection either way.
EMBEDDING_PROVIDER=ollama

# Only used when EMBEDDING_PROVIDER=ollama.
OLLAMA_URL=http://localhost:11434

# Only used when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=

# Leave unset to use the provider's default (bge-m3 / text-embedding-3-small).
# EMBEDDING_MODEL=

BATCH_SIZE=32

# Only needed if you regenerate data/grundschutzpp-controls.jsonl yourself
# (export.py). Points at a local sibling checkout of
# BSI-Bund/Stand-der-Technik-Bibliothek by default, same layout as
# grundschutz-docs/docs.
# GRUNDSCHUTZPP_CATALOG=
# GRUNDSCHUTZPP_BASETHREATS=
# GRUNDSCHUTZPP_TAGS=
# GRUNDSCHUTZPP_MAPPING=
# BSI_BAUSTEINE_LINKS=
SITE_URL=https://grundschutz-docs.de
