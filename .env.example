QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=grundschutzpp

# Embeddings: any server that speaks the OpenAI embeddings API
# (POST {EMBEDDING_BASE_URL}/embeddings). The defaults below match the
# Ollama from docker-compose.yml, so a local setup needs no changes.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
# Only for servers that need a key. Leave empty for local ones.
EMBEDDING_API_KEY=

# Other servers -- uncomment one block, and comment out the three lines above:
#
# vLLM, serving an embedding model (see the vLLM docs for how to start one):
# EMBEDDING_BASE_URL=http://localhost:8000/v1
# EMBEDDING_MODEL=BAAI/bge-m3
#
# OpenAI:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
#
# Every model has its own vector size. When you switch models, also switch
# QDRANT_COLLECTION (or delete the old collection) -- indexing stops with a
# clear message otherwise.

BATCH_SIZE=32

# Only needed if you regenerate data/grundschutzpp-controls.jsonl yourself
# (export.py). Points at a local sibling checkout of
# BSI-Bund/Stand-der-Technik-Bibliothek by default, same layout as
# grundschutz-docs/docs.
# GRUNDSCHUTZPP_CATALOG=
# GRUNDSCHUTZPP_BASETHREATS=
# GRUNDSCHUTZPP_TAGS=
# GRUNDSCHUTZPP_MAPPING=
# BSI_BAUSTEINE_LINKS=
SITE_URL=https://grundschutz-docs.de
